    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const raw = item.json.output[0].content[0].text;\n  const cleanedRaw = raw\n    .trim()\n    .replace(/^```json\\s*/i, '')\n    .replace(/^```\\s*/i, '')\n    .replace(/\\s*```$/i, '');\n\n  try {\n    const parsed = JSON.parse(cleanedRaw);\n    results.push({\n      json: {\n        score:        Number(parsed.score),\n        summary:      parsed.summary,\n        title:        parsed.title,\n        link:         parsed.link,\n        image_prompt: parsed.image_prompt,\n      }\n    });\n  } catch (error) {\n    results.push({ json: { error: `Failed to parse JSON: ${error.message}` } });\n  }\n}\n\nreturn results;"
      },
