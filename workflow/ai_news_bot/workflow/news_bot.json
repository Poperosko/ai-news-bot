      "parameters": {
        "jsCode": "const sheetsValues = $input.first().json.values || [];\n\nconst publishedUrls = new Set(\n  sheetsValues.slice(1).map(row => row[0]).filter(v => !!v)\n);\n\nconst articles = $('Filter_AI').all().map(i => i.json);\nconst newArticles = articles.filter(a => !publishedUrls.has(a.url || a.link));\n\nif (!newArticles.length) return [];\n\nconst best = newArticles.reduce((top, a) =>\n  (a.score || 0) > (top.score || 0) ? a : top\n);\n\nconst rows = sheetsValues.slice(1).filter(row => row[1] === 'AI').length;\nconst generateImage = rows > 0 && rows % 3 === 0;\nconst enclosureUrl = $('RSS Read').first().json.enclosure?.url || '';\n\nreturn [{ json: { ...best, generateImage, photo_url: enclosureUrl, debug_rows: rows } }];"
      },
