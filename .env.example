# ============================================================
# AI News Bot — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ----------------------------
# Polza AI API
# ----------------------------
POLZA_AI_API_KEY=your_polza_ai_api_key_here
POLZA_AI_BASE_URL=https://api.polza.ai/v1

# ----------------------------
# Telegram
# ----------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHANNEL_ID=@your_channel_or_-1001234567890

# ----------------------------
# Google Sheets
# ----------------------------
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com

# Path to your Google Service Account JSON key file
# (Only needed if running n8n locally)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-service-account.json

# ----------------------------
# n8n Configuration (optional)
# Only needed for self-hosted n8n via Docker
# ----------------------------
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=localhost
